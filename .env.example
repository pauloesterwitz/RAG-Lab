# Copy this file to .env and fill in your values.
# config.py loads .env automatically on startup.

# One of these is required for provider=claude (the default):
# API key from console.anthropic.com:
ANTHROPIC_API_KEY=sk-ant-...
# OR: an OAuth bearer token:
# ANTHROPIC_AUTH_TOKEN=<token>

# Optional overrides (defaults shown)
# RAG_PROVIDER=claude          # "claude" or "llamaswap"
# RAG_GEN_MODEL=claude-sonnet-4-6
# RAG_JUDGE_MODEL=claude-sonnet-4-6
# RAG_EMBED_MODEL=intfloat/multilingual-e5-small
# RAG_EMBED_DIM=384

# To switch to local models via llama-swap (embeddings stay sentence-transformers
# either way — see config.py — so RAG_EMBED_MODEL/DIM don't need to change here):
# RAG_PROVIDER=llamaswap
# RAG_GEN_MODEL=<a llama-swap member id, e.g. qwen38fn-sglang-tp2-starfleet>
# RAG_JUDGE_MODEL=<same>
